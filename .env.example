# ==============================================================================
# Buildicy Email Delivery Configuration (Resend)
# ==============================================================================

# Resend API Key (Create at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Client-side fallback API Key (optional for Vite preview / client dispatches)
VITE_RESEND_API_KEY=re_your_api_key_here

# Where all leads, audits, contact inquiries, and job applications should be sent
NOTIFY_EMAIL=hello@buildicy.com

# Sender email address
# Testing mode: Resend allows sending from onboarding@resend.dev to the email address registered with your Resend account.
# Production mode: Once buildicy.com is verified in Resend (Domains -> Add Domain -> DNS records), set to your custom domain:
# RESEND_FROM_EMAIL=Buildicy Studio <hello@buildicy.com>
RESEND_FROM_EMAIL=Buildicy Notifications <onboarding@resend.dev>


